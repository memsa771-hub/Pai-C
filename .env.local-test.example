# Local test of branch pai-merge (PAI C + PAI OS) on your own PC. NO KEYS NEEDED.
#
#   Copy this file to .env (in PowerShell:  Copy-Item .env.local-test.example .env)
#   then start with:  python scripts/run.py
#
# Guide: docs/local-test/WINDOWS-GUIDE.md
#
# Everything here is fake or local. This stack never reaches the live pai-c: sign-in goes to a
# local Firebase Auth emulator (project "demo-pai-merge"), the database is a fresh local Postgres
# in its own Docker volume, emails are only written to the log, and PAI OS uses canned offline
# answers instead of OpenAI. docker-compose.yml pins the safety settings (emulator, rehearsal,
# offline AI, logged email), so changing them here has no effect.
#
# Never paste a real API key or real student data into this file.

# --- Counsellor (PAI C) -------------------------------------------------------------------------
# Same as .env.example. There is no OpenAI key here on purpose, so the Counsellor's chat cannot
# call a model: it answers with the fallback replies below. That is expected in this test.
# Recommended Counselor settings. Copy into your local .env as needed.
# Anything not set here falls back to the defaults in backend/app/config.py.
PAI_COUNSELOR_MODEL=gpt-6-sol
PAI_COUNSELOR_REASONING_EFFORT=low
PAI_ANALYST_MODEL=gpt-5-mini

# PAI C safety gate (model falls back to Analyst, then PAI_MODEL).
PAI_SAFETY_MODEL=
PAI_SAFETY_REASONING_EFFORT=low
PAI_SAFETY_TIMEOUT_MS=3000
PAI_WELLBEING_RESOURCES=
PAI_WELLBEING_FALLBACK_REPLY=I'm sorry you're going through this. Please reach out to someone you trust. If you are in immediate danger, contact local emergency services.

# Planner bounded map view and recent chat entries.
PAI_PLANNER_MAP_CONTEXT_TOKENS=4000
PAI_PLAN_MAX_AGE_TURNS=3
PAI_REPEAT_QUESTION_WINDOW=5
PAI_REPEAT_QUESTION_SIMILARITY=0.6
PAI_PLANNER_HISTORY_TURNS=12

# Core R2 turn classifier and conversation cadence
PAI_CLASSIFIER_MODEL=
PAI_CLASSIFIER_REASONING_EFFORT=low
PAI_CLASSIFIER_TIMEOUT_MS=8000
PAI_SUMMARY_EVERY_TURNS=4
# PAI C semantic recall uses the Qdrant index (on by default). Embeddings need their own
# key; without it recall stays lexical and every feature still works from the Vault.
PAI_SEMANTIC_RECALL_ENABLED=true
# OpenAI-compatible embeddings key (model MEMORY_EMBEDDING_MODEL, default text-embedding-3-small).
MEMORY_EMBEDDING_API_KEY=
# Estimated embeddings spend per UTC month; at the cap no vectors are made until next month.
# Rates per model: backend/app/pai_c/policy/embedding_costs.json.
PAI_EMBEDDING_MONTHLY_CAP_USD=5
PAI_REPEAT_REPLY_SIMILARITY=0.5
PAI_STATEMENT_FALLBACK_REPLY="Thank you for sharing that with me. I'm taking it in, and I'll keep it in mind as we continue."

PAI_OPENING_FALLBACK_REPLY="Hi {name}, I'm PAI, your counselor. Before anything else, I'd like to get to know you a little, so that my help fits you. Tell me about yourself, whatever you feel is important for me to know."

# --- Local URLs -----------------------------------------------------------------------------------
APP_URL=http://localhost:3000

# --- Sign-in: local Firebase Auth emulator (set in docker-compose.yml, nothing to fill in) -----
# The emulator's page of test users: http://localhost:4000/auth
# No real Firebase project, no service account file, no Resend key.
RESEND_API_KEY=

# --- PAI OS ("Study abroad plan") --------------------------------------------------------------
# Shown here so you can see what is on. docker-compose.yml sets the same values for the
# backend, os-setup and os-worker containers.
OS_ENABLED=true
# Rehearsal mode: the OS clock is moved only by the admin calls (advance / tick) in the guide.
OS_REHEARSAL=on
# Offline AI: canned answers, no OpenAI call and no cost. Needs rehearsal mode.
OS_MODEL_MODE=offline
# Emails from PAI OS are only written to the worker's log, never sent.
OS_EMAIL_SENDER=log
# The local admin token for the rehearsal calls in the guide (X-OS-Admin-Token header).
# A made-up local value, not a secret. If you change it, use the same value in the guide's commands.
OS_ADMIN_TOKEN=local-test-admin-token
