{
  "$defs": {
    "IntakeRef": {
      "additionalProperties": false,
      "properties": {
        "term": {
          "pattern": "^[a-z_]+$",
          "title": "Term",
          "type": "string"
        },
        "year": {
          "maximum": 2100,
          "minimum": 2025,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "term",
        "year"
      ],
      "title": "IntakeRef",
      "type": "object"
    },
    "ProgrammeChoice": {
      "additionalProperties": false,
      "properties": {
        "programme_ref": {
          "minLength": 1,
          "title": "Programme Ref",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        }
      },
      "required": [
        "programme_ref",
        "rank"
      ],
      "title": "ProgrammeChoice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pai.choice_request.v1",
      "default": "pai.choice_request.v1",
      "title": "Schema",
      "type": "string"
    },
    "key": {
      "minLength": 1,
      "title": "Key",
      "type": "string"
    },
    "student_ref": {
      "minLength": 1,
      "title": "Student Ref",
      "type": "string"
    },
    "journey_id": {
      "minLength": 1,
      "title": "Journey Id",
      "type": "string"
    },
    "proposal_id": {
      "title": "Proposal Id",
      "type": "integer"
    },
    "based_on_version": {
      "minimum": 1,
      "title": "Based On Version",
      "type": "integer"
    },
    "programmes": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ProgrammeChoice"
          },
          "maxItems": 5,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Programmes"
    },
    "target_intake": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntakeRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    }
  },
  "required": [
    "key",
    "student_ref",
    "journey_id",
    "proposal_id",
    "based_on_version",
    "requested_at"
  ],
  "title": "ChoiceRequestV1",
  "type": "object"
}
