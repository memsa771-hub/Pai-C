{
  "$defs": {
    "StudentFact": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z_]+(\\.[a-z0-9_]+)*$",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "evidence": {
          "enum": [
            "stated",
            "shown",
            "confirmed",
            "unknown"
          ],
          "title": "Evidence",
          "type": "string"
        },
        "vault_version": {
          "minimum": 0,
          "title": "Vault Version",
          "type": "integer"
        },
        "document_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Ref"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        }
      },
      "required": [
        "key",
        "value",
        "evidence",
        "vault_version"
      ],
      "title": "StudentFact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pai.student_facts.v1",
      "default": "pai.student_facts.v1",
      "title": "Schema",
      "type": "string"
    },
    "student_ref": {
      "minLength": 1,
      "title": "Student Ref",
      "type": "string"
    },
    "vault_version": {
      "minimum": 0,
      "title": "Vault Version",
      "type": "integer"
    },
    "built_at": {
      "format": "date-time",
      "title": "Built At",
      "type": "string"
    },
    "eligible_levels": {
      "anyOf": [
        {
          "items": {
            "enum": [
              "intermediate",
              "foundation",
              "bachelor",
              "master",
              "phd"
            ],
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Eligible Levels"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/StudentFact"
      },
      "title": "Facts",
      "type": "array"
    }
  },
  "required": [
    "student_ref",
    "vault_version",
    "built_at",
    "eligible_levels",
    "facts"
  ],
  "title": "StudentFactsV1",
  "type": "object"
}
