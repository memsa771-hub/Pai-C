          "type": "string"
        },
        "year": {
          "maximum": 2100,
          "minimum": 2025,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "term",
        "year"
      ],
      "title": "IntakeRef",
      "type": "object"
    },
    "MarkUsed": {
