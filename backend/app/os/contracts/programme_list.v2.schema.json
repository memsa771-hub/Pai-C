{
  "$defs": {
    "IntakeRef": {
      "additionalProperties": false,
      "properties": {
        "term": {
          "pattern": "^[a-z_]+$",
          "title": "Term",
          "type": "string"
        },
        "year": {
          "maximum": 2100,
          "minimum": 2025,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "term",
        "year"
      ],
      "title": "IntakeRef",
      "type": "object"
    },
    "ProgrammeEntryV2": {
      "additionalProperties": false,
      "properties": {
        "programme_ref": {
          "title": "Programme Ref",
          "type": "string"
        },
        "university": {
          "title": "University",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "facts_confirmed": {
          "title": "Facts Confirmed",
          "type": "boolean"
        },
        "coverage_level": {
          "enum": [
            "listed",
            "researched",
            "verified"
          ],
          "title": "Coverage Level",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "not_run_yet": {
          "default": false,
          "title": "Not Run Yet",
          "type": "boolean"
        }
      },
      "required": [
        "programme_ref",
        "university",
        "name",
        "facts_confirmed",
        "coverage_level"
      ],
      "title": "ProgrammeEntryV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pai.programme_list.v2",
      "default": "pai.programme_list.v2",
      "title": "Schema",
      "type": "string"
    },
    "route_key": {
      "title": "Route Key",
      "type": "string"
    },
    "intake": {
      "$ref": "#/$defs/IntakeRef"
    },
    "programmes": {
      "items": {
        "$ref": "#/$defs/ProgrammeEntryV2"
      },
      "title": "Programmes",
      "type": "array"
    }
  },
  "required": [
    "route_key",
    "intake",
    "programmes"
  ],
  "title": "ProgrammeListV2",
  "type": "object"
}
