          "title": "study_fields",
          "details.field_of_study": "study_fields"
        }
      },
      "strength": {
        "fields": [
          "text",
          "basis"
        ],
        "join": " — "
      },
      "interest": {
        "fields": [
          "text",
          "example"
        ],
        "join": " — "
      },
      "option": {
        "fields": [
          "text",
          "status"
        ]
      },
      "family_member": {
        "fields": [
          "relation",
          "name",
          "occupation",
          "education",
          "wish",
          "concern",
          "influence"
        ]
      }
    }
