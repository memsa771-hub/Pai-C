    "financial_sponsor": {"label": "Financial sponsor", "section": "money_and_place", "sensitivity": "sensitive",
                          "money": true},
    "scholarship_application": {"label": "Scholarship application", "section": "money_and_place",
                                "sensitivity": "sensitive", "money": true},
    "application": {"label": "Application", "section": "money_and_place", "sensitivity": "normal"},
    "visa": {"label": "Visa", "section": "money_and_place", "sensitivity": "sensitive"},
    "research": {"label": "Research", "section": "education", "sensitivity": "normal"},
    "credential": {"label": "Credential", "section": "education", "sensitivity": "normal",
                   "file_field": "raw_document_ref"},
    "external_influence": {"label": "What others want for you", "section": "about", "sensitivity": "sensitive",
                           "omit_fields": ["student_response"], "chat_input": false},
    "student_voice_statement": {"hidden": true, "reason": "holds original words; spec Language",
                                "chat_input": false}
  },
  "file_record_kind": "document",
  "story_rich_min_entries": 2,
  "answers": {
    "default": ["keep_current", "accept_proposed", "both_true", "provide_new"],
    "document_owner": ["keep_current", "accept_proposed"],
    "no_current_value": ["accept_proposed", "provide_new"]
  },
  "conflict_copy": {
    "item": {
      "summary": "Two different answers for your {label}.",
      "question": "Your {label} is saved differently from what you just shared. Which one is right?"
    },
    "fact": {
      "summary": "Two different answers for your {label}.",
      "question": "Which {label} is right?"
    },
    "record": {
      "summary": "Two different versions of your {label}.",
      "question": "Which {label} details are right?"
    },
    "document_owner": {
      "summary": "A document may belong to someone else.",
      "question": "Is {filename} your document?",
      "sensitivity": "sensitive"
    },
    "other": {
      "summary": "PAI needs you to check something in your Vault.",
      "question": "Can you check this entry?"
    }
  },
  "display": {
    "_note": "How an entry reads on every page (VAULT_SPEC Language; audit #4: no raw codes). Choice codes read through the catalog lists; schema codes through enum_labels, else as words; hidden_fields never show; types pick fields and order.",
    "separator": ", ",
    "yes": "Yes",
    "no": "No",
    "hidden_fields": [
      "canonical_level",
      "normalized_name",
      "currency",
      "approximate",
      "goal_type",
      "voice_type",
      "influence_type",
      "student_response",
      "original_name",
      "grading_system"
    ],
    "enum_labels": {
      "academic_status": {
        "current": "Studying now",
        "completed": "Completed",
        "incomplete": "Not completed",
        "planned": "Planned"
      },
      "period": {
        "per_year": "per year",
        "per_month": "per month",
        "total": "in total"
      },
      "influencer_type": {
        "parent": "Parent",
        "sibling": "Brother or sister",
        "social_media": "Social media",
        "social_expectation": "What people expect"
      }
    },
    "field_templates": {
      "influence": "{value} influence",
      "possible_without_scholarship": "Possible without a scholarship: {value}",
      "student_alignment": "Student: {value}"
    },
    "result": {
      "marks": "{obtained}/{total} ({percent}%)",
      "percent": "{percent}%",
      "gpa": "GPA {gpa}",
      "gpa_scale": "GPA {gpa}/{scale}",
      "grade": "Grade {grade}"
    },
    "budget": {
      "amount_fields": [
        "band",
        "min",
        "max",
        "amount"
      ],
      "lakh": 100000,
      "lakh_template": "{amount} lakh",
      "band_currency": "PKR",
      "foreign_template": "{amount} {currency}",
      "band_ranges": {
        "under_1_lakh": [
          0,
          100000
        ],
        "1_3_lakh": [
          100000,
          300000
        ],
        "3_6_lakh": [
          300000,
          600000
        ],
        "6_10_lakh": [
          600000,
          1000000
        ],
        "over_10_lakh": [
          1000000,
          null
        ]
      }
    },
    "types": {
      "education": {"order": ["qualification_name", "field_of_study", "details", "institution_name",
