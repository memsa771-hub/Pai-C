    {"key": "money_and_place", "label": "Money and place"},
    {"key": "documents", "label": "Documents"}
  ],
  "default_section": "about",
  "uncatalogued_records": {
    "document": {"label": "Document", "section": "documents", "sensitivity": "sensitive",
