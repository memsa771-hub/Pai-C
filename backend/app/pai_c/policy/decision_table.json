{
  "derived": {
    "summary_min_covered": 2,
    "invite_max_covered": 3,
    "question_window": 2,
    "short_reply_intent": "short_reply",
    "summary_action": "summarize"
  },
  "rows": [
    {
      "id": "care",
      "when": {
        "in": [
          {
            "ref": "safety.level"
          },
          [
            "concern",
            "urgent"
          ]
        ]
      },
      "set": {
        "action": "care",
        "question_allowed": false,
        "topic": null,
        "invite": false
      }
    },
    {
      "id": "answer",
      "when": {
        "ne": [
          {
            "ref": "request"
          },
          null
        ]
      },
      "set": {
        "action": "answer_request",
        "question_allowed": {
          "ref": "request.needs_context"
        },
        "topic": "request",
        "invite": false
      }
    },
    {
      "id": "clear_myth",
      "when": {
        "ne": [
          {
            "ref": "relevant_myth"
          },
          null
        ]
      },
      "set": {
        "action": "clear_myth",
        "question_allowed": false,
        "topic": {
          "ref": "relevant_myth"
        },
        "invite": false
      }
    },
    {
      "id": "follow_thread",
      "when": {
        "ne": [
          {
            "ref": "opened_thread"
          },
          null
        ]
      },
      "set": {
        "action": "follow_thread",
        "question_allowed": {
          "ref": "question_needed"
        },
        "topic": {
          "ref": "opened_thread"
        },
        "invite": false
      }
    },
    {
      "id": "mirror_changes",
      "when": {
        "ref": "mirror_correction"
      },
      "set": {
        "action": "explore_correction",
        "question_allowed": true,
        "topic": {
          "first": {
            "ref": "mentioned_areas"
          }
        },
        "invite": false
      }
    },
    {
      "id": "adjust",
      "when": {
        "eq": [
          {
            "ref": "intent"
          },
          "pushback"
        ]
      },
      "set": {
        "action": "adjust",
        "question_allowed": {
          "ref": "question_needed"
        },
        "topic": null,
        "invite": false
      }
    },
    {
      "id": "guide",
      "when": {
        "eq": [
          {
            "ref": "intent"
          },
          "deciding"
        ]
      },
      "set": {
        "action": "guide",
        "question_allowed": {
          "ref": "question_needed"
        },
        "topic": null,
        "invite": false
      }
    },
    {
      "id": "mirror",
      "when": {
        "ref": "mirror_allowed"
      },
      "set": {
        "action": "mirror",
        "question_allowed": false,
        "topic": null,
        "invite": false
      }
    },
    {
      "id": "summarize",
      "when": {
        "ref": "summary_due"
      },
      "set": {
        "action": "summarize",
        "question_allowed": {
          "ref": "question_needed"
        },
        "topic": null,
        "invite": false
      }
    },
    {
      "id": "discover",
      "when": {
        "ref": "discover_available"
      },
      "set": {
        "action": "discover",
        "topic": {
          "ref": "possibility_id"
        },
        "question_allowed": {
          "ref": "question_needed"
        },
        "invite": false
      }
    },
    {
      "id": "listen",
      "when": {
        "in": [
          {
            "ref": "emotion"
          },
          [
            "stressed",
            "frustrated"
          ]
        ]
      },
      "set": {
        "action": "listen_reflect",
        "question_allowed": false,
        "topic": null,
        "invite": false
      }
    },
    {
      "id": "choice",
      "when": {
        "all": [
          {
            "all": [
              {
                "gte": [
                  {
                    "ref": "short_reply_streak"
                  },
                  2
                ]
              },
              {
                "ne": [
                  {
                    "ref": "askable_area"
                  },
                  null
                ]
              }
            ]
          },
          {
            "ref": "question_needed"
          }
        ]
      },
      "set": {
        "action": "ask_choice",
        "question_allowed": {
          "ref": "question_needed"
        },
        "topic": {
          "ref": "askable_area"
        },
        "invite": false
      }
    },
    {
      "id": "ask",
      "when": {
        "all": [
          {
            "ne": [
              {
                "ref": "askable_area"
              },
              null
            ]
          },
          {
            "ref": "question_needed"
          }
        ]
      },
      "set": {
        "action": "ask",
        "question_allowed": {
          "ref": "question_needed"
        },
        "topic": {
          "ref": "askable_area"
        },
        "invite": false
      }
    },
    {
      "id": "default",
      "when": true,
      "set": {
        "action": {
          "if": [
            {
              "ref": "insight_available"
            },
            "insight",
            "listen_reflect"
          ]
        },
        "question_allowed": false,
        "topic": null,
        "invite": false
      }
    }
  ],
  "post_checks": [
    {
      "id": "no_repeat",
      "when": {
        "all": [
          {
            "eq": [
              {
                "ref": "chosen.action"
              },
              {
                "ref": "previous.action"
              }
            ]
          },
          {
            "eq": [
              {
                "ref": "chosen.topic"
              },
              {
                "ref": "previous.topic"
              }
            ]
          }
        ]
      },
      "branches": [
        {
          "when": {
            "all": [
              {
                "eq": [
                  {
                    "ref": "chosen.question_allowed"
                  },
                  false
                ]
              },
              {
                "eq": [
                  {
                    "ref": "chosen.action"
                  },
                  "listen_reflect"
                ]
              },
              {
                "ref": "insight_available"
              }
            ]
          },
          "set": {
            "action": "insight",
            "question_allowed": false,
            "topic": null,
            "invite": false
          }
        },
        {
          "when": {
            "all": [
              {
                "eq": [
                  {
                    "ref": "chosen.question_allowed"
                  },
                  false
                ]
              },
              {
                "eq": [
                  {
                    "ref": "chosen.action"
                  },
                  "insight"
                ]
              }
            ]
          },
          "set": {
            "action": "listen_reflect",
            "question_allowed": false,
            "topic": null,
            "invite": false
          }
        },
        {
          "when": {
            "all": [
              {
                "ref": "chosen.question_allowed"
              },
              {
                "in": [
                  {
                    "ref": "chosen.action"
                  },
                  [
                    "ask",
                    "ask_choice"
                  ]
                ]
              }
            ]
          },
          "set": {
            "action": {
              "if": [
                {
                  "ne": [
                    {
                      "ref": "next_askable_area"
                    },
                    null
                  ]
                },
                {
                  "ref": "chosen.action"
                },
                {
                  "if": [
                    {
                      "ref": "insight_available"
                    },
                    "insight",
                    "listen_reflect"
                  ]
                }
              ]
            },
            "question_allowed": {
              "ne": [
                {
                  "ref": "next_askable_area"
                },
                null
              ]
            },
            "topic": {
              "ref": "next_askable_area"
            },
            "invite": false
          }
        },
        {
          "when": {
            "all": [
              {
                "ref": "chosen.question_allowed"
              },
              {
                "eq": [
                  {
                    "ref": "chosen.action"
                  },
                  "adjust"
                ]
              }
            ]
          },
          "set": {
            "action": {
              "if": [
                {
                  "ne": [
                    {
                      "ref": "askable_area"
                    },
                    null
                  ]
                },
                "ask",
                "summarize"
              ]
            },
            "question_allowed": true,
            "topic": {
              "ref": "askable_area"
            },
            "invite": false
          }
        },
        {
          "when": {
            "all": [
              {
                "ref": "chosen.question_allowed"
              },
              {
                "eq": [
                  {
                    "ref": "chosen.action"
                  },
                  "summarize"
                ]
              }
            ]
          },
          "set": {
            "action": {
              "if": [
                {
                  "ne": [
                    {
                      "ref": "askable_area"
                    },
                    null
                  ]
                },
                "ask",
                {
                  "if": [
                    {
                      "ref": "insight_available"
                    },
                    "insight",
                    "listen_reflect"
                  ]
                }
              ]
            },
            "question_allowed": {
              "ne": [
                {
                  "ref": "askable_area"
                },
                null
              ]
            },
            "topic": {
              "ref": "askable_area"
            },
            "invite": false
          }
        }
      ]
    },
    {
      "id": "useful_question",
      "when": {
        "all": [
          {
            "ref": "chosen.question_allowed"
          },
          {
            "eq": [
              {
                "ref": "question_needed"
              },
              false
            ]
          },
          {
            "ne": [
              {
                "ref": "chosen.action"
              },
              "answer_request"
            ]
          },
          {
            "ne": [
              {
                "ref": "chosen.action"
              },
              "first_picture"
            ]
          },
          {
            "ne": [
              {
                "ref": "chosen.action"
              },
              "explore_correction"
            ]
          },
          {
            "ne": [
              {
                "ref": "chosen.action"
              },
              "care"
            ]
          }
        ]
      },
      "branches": [
        {
          "when": true,
          "set": {
            "action": {
              "ref": "chosen.action"
            },
            "question_allowed": false,
            "topic": {
              "ref": "chosen.topic"
            },
            "invite": {
              "ref": "chosen.invite"
            }
          }
        }
      ]
    }
  ]
}
