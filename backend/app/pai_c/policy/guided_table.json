{
  "derived": {
    "first_picture_action": "first_picture",
    "first_picture_min_covered_areas": 4,
    "first_picture_required_areas": [
      "status",
      "history"
    ],
    "summary_min_covered": 2,
    "invite_max_covered": 3,
    "question_window": 2,
    "short_reply_intent": "short_reply",
    "summary_action": "summarize"
  },
  "question_due": {
    "any": [
      {
        "ref": "question_needed"
      },
      {
        "all": [
          {
            "ne": [
              {
                "ref": "askable_basic"
              },
              null
            ]
          },
          {
            "ne": [
              {
                "ref": "questions_in_last_two"
              },
              true
            ]
          }
        ]
      },
      {
        "ref": "basic_due"
      }
    ]
  },
  "drive": {
    "_note": "Every reply ends with the next step (next_steps.json), except these actions and a student who asked to stop (BETA_CONVERSATION_SPEC 2.3).",
    "exempt_actions": [
      "care"
    ],
    "exempt_intents": [
      "stop"
    ]
  },
  "rows": [
    {
      "id": "care",
      "when": {
        "in": [
          {
            "ref": "safety.level"
          },
          [
            "concern",
            "urgent"
          ]
        ]
      },
      "set": {
        "action": "care",
        "question_allowed": false,
        "topic": null,
        "invite": false
      }
    },
    {
      "id": "about_pai",
      "when": {
        "eq": [
          {
            "ref": "request.kind"
          },
          "about_pai"
        ]
      },
      "set": {
        "action": "about_pai",
        "question_allowed": {
          "ref": "question_due"
        },
        "topic": "request",
        "invite": false
      }
    },
    {
      "id": "answer",
      "when": {
        "ne": [
          {
            "ref": "request"
          },
          null
        ]
      },
      "set": {
        "action": "answer_request",
        "question_allowed": {
          "ref": "request.needs_context"
        },
        "topic": "request",
        "invite": false
      }
    },
    {
      "id": "intro",
      "when": {
        "ref": "intro_due"
      },
      "set": {
        "action": "intro",
        "question_allowed": true,
        "topic": null,
        "invite": false,
        "bank_intent": "about_you",
        "bank_followup": false
      }
    },
    {
      "id": "bank_question",
      "when": {
        "ne": [
          {
            "ref": "next_bank_item"
          },
          null
        ]
      },
      "set": {
        "action": "bank_question",
        "question_allowed": true,
        "topic": {
          "ref": "next_bank_item.area"
        },
        "invite": false,
        "bank_intent": {
          "ref": "next_bank_item.intent_key"
        },
        "bank_followup": {
          "ref": "next_bank_item.followup"
        }
      }
    },
    {
      "id": "clear_myth",
      "when": {
        "ne": [
          {
            "ref": "relevant_myth"
          },
          null
        ]
      },
      "set": {
        "action": "clear_myth",
        "question_allowed": false,
        "topic": {
          "ref": "relevant_myth"
        },
        "invite": false
      }
    },
    {
      "id": "follow_thread",
      "when": {
        "ne": [
          {
            "ref": "opened_thread"
          },
          null
        ]
      },
      "set": {
        "action": "follow_thread",
        "question_allowed": {
          "ref": "question_due"
        },
        "topic": {
          "ref": "opened_thread"
        },
        "invite": false
      }
    },
    {
      "id": "mirror",
      "when": {
        "ref": "mirror_due"
      },
      "set": {
        "action": "mirror",
        "question_allowed": false,
        "topic": null,
        "invite": false
      }
    },
    {
      "id": "first_picture",
      "when": {
        "ref": "first_picture_due"
      },
      "set": {
        "action": "first_picture",
        "question_allowed": true,
        "topic": null,
        "invite": false
      }
    },
    {
      "id": "guide",
      "when": {
        "eq": [
          {
            "ref": "intent"
          },
          "deciding"
        ]
      },
      "set": {
        "action": "guide",
        "question_allowed": {
          "ref": "question_due"
        },
        "topic": null,
        "invite": false
      }
    },
    {
      "id": "discover",
      "when": {
        "ref": "discover_available"
      },
      "set": {
        "action": "discover",
        "question_allowed": {
          "ref": "question_due"
        },
        "topic": {
          "ref": "possibility_id"
        },
        "invite": false
      }
    },
    {
      "id": "explore_area",
      "when": {
        "all": [
          {
            "ne": [
              {
                "ref": "askable_area"
              },
              null
            ]
          },
          {
            "ref": "question_due"
          }
        ]
      },
      "set": {
        "action": "explore_area",
        "question_allowed": {
          "ref": "question_due"
        },
        "topic": {
          "if": [
            {
              "ref": "askable_basic"
            },
            {
              "ref": "askable_basic"
            },
            {
              "ref": "askable_area"
            }
          ]
        },
        "invite": false
      }
    },
    {
      "id": "counsel",
      "when": true,
      "set": {
        "action": "counsel",
        "question_allowed": {
          "ref": "question_due"
        },
        "topic": null,
        "invite": false
      }
    }
  ],
  "post_checks": [
    {
      "id": "useful_question",
      "when": {
        "all": [
          {
            "ref": "chosen.question_allowed"
          },
          {
            "eq": [
              {
                "ref": "question_due"
              },
              false
            ]
          },
          {
            "ne": [
              {
                "ref": "chosen.action"
              },
              "answer_request"
            ]
          },
          {
            "ne": [
              {
                "ref": "chosen.action"
              },
              "first_picture"
            ]
          },
          {
            "ne": [
              {
                "ref": "chosen.action"
              },
              "care"
            ]
          },
          {
            "ne": [
              {
                "ref": "chosen.action"
              },
              "intro"
            ]
          },
          {
            "ne": [
              {
                "ref": "chosen.action"
              },
              "bank_question"
            ]
          }
        ]
      },
      "branches": [
        {
          "when": true,
          "set": {
            "action": {
              "ref": "chosen.action"
            },
            "question_allowed": false,
            "topic": {
              "ref": "chosen.topic"
            },
            "invite": {
              "ref": "chosen.invite"
            }
          }
        }
      ]
    }
  ]
}
