# Recommended Counselor settings. Copy into your local .env as needed.
# Anything not set here falls back to the defaults in backend/app/config.py.
# Provider per role (defaults: backend/app/pai_c/policy/model_roles.json). Any role can be
# switched with PAI_<ROLE>_PROVIDER (openai | anthropic) and PAI_<ROLE>_MODEL. Without
# ANTHROPIC_API_KEY an anthropic role runs on the OpenAI provider (PAI_API_KEY).
ANTHROPIC_API_KEY=
PAI_COUNSELOR_PROVIDER=anthropic
PAI_COUNSELOR_MODEL=claude-sonnet-5-5
PAI_COUNSELOR_REASONING_EFFORT=low
PAI_ANALYST_MODEL=gpt-5
PAI_MIRROR_MODEL=gpt-5
PAI_RESEARCHER_MODEL=gpt-5
# One estimated spend cap for every model call per UTC month (rates: model_costs.json).
# At 80% research, path analysis and Mirror text stop; at 100% chat replies say PAI is paused.
PAI_MONTHLY_CAP_USD=100
# Signed-in emails that may read GET /v1/admin/usage (comma separated).
PAI_FOUNDER_EMAILS=

# PAI C safety gate (model falls back to Analyst, then PAI_MODEL).
PAI_SAFETY_MODEL=
PAI_SAFETY_REASONING_EFFORT=low
PAI_SAFETY_TIMEOUT_MS=3000
PAI_WELLBEING_RESOURCES=
PAI_WELLBEING_FALLBACK_REPLY=I'm sorry you're going through this. Please reach out to someone you trust. If you are in immediate danger, contact local emergency services.

# Planner bounded map view and recent chat entries.
PAI_PLANNER_MAP_CONTEXT_TOKENS=4000
PAI_PLAN_MAX_AGE_TURNS=3
PAI_REPEAT_QUESTION_WINDOW=5
PAI_REPEAT_QUESTION_SIMILARITY=0.6
PAI_PLANNER_HISTORY_TURNS=12

# Core R2 turn classifier and conversation cadence
PAI_CLASSIFIER_MODEL=
PAI_CLASSIFIER_REASONING_EFFORT=low
PAI_CLASSIFIER_TIMEOUT_MS=8000
PAI_SUMMARY_EVERY_TURNS=4
# PAI C semantic recall uses the Qdrant index (on by default). Embeddings need their own
# key; without it recall stays lexical and every feature still works from the Vault.
PAI_SEMANTIC_RECALL_ENABLED=true
# OpenAI-compatible embeddings key (model MEMORY_EMBEDDING_MODEL, default text-embedding-3-small).
MEMORY_EMBEDDING_API_KEY=
# Estimated embeddings spend per UTC month; at the cap no vectors are made until next month.
# Rates per model: backend/app/pai_c/policy/embedding_costs.json.
PAI_EMBEDDING_MONTHLY_CAP_USD=5
PAI_REPEAT_REPLY_SIMILARITY=0.5
PAI_STATEMENT_FALLBACK_REPLY="Thank you for sharing that with me. I'm taking it in, and I'll keep it in mind as we continue."

PAI_OPENING_FALLBACK_REPLY="Hi {name}, I'm PAI, your counselor. Before anything else, I'd like to get to know you a little, so that my help fits you. Tell me about yourself, whatever you feel is important for me to know."

# --- Sign-in: Firebase Auth (project "Placement-ai") ---------------------------
# Backend: the project id and the service-account JSON. Docker mounts the file
# at FIREBASE_SERVICE_ACCOUNT_FILE (default ./secrets/firebase-service-account.json,
# git-ignored) into the container; outside Docker set FIREBASE_SERVICE_ACCOUNT to
# the file's path. Never commit the JSON.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT=
# Local tests only: point the backend at the Auth emulator instead.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Frontend: the public web-app config from `firebase apps:sdkconfig WEB` (not secrets).
NEXT_PUBLIC_FIREBASE_API_KEY=
# The backend uses the same public key to complete password resets (defaults to the line above).
# FIREBASE_WEB_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Account emails (verify email, reset password, new sign-in) go through Resend;
# Firebase never sends its own. Their links open APP_URL/auth/action.
RESEND_API_KEY=
EMAIL_FROM=Placement AI <noreply@placement-ai.com>
APP_URL=https://app.placement-ai.com
# Limits on these endpoints: backend/app/security/auth_limits.json (counted in Redis).
