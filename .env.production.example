# Production environment for docker-compose.prod.yml. Copy to .env on the server
# and fill every value marked REQUIRED. Never commit .env. The public origins
# (app.placement-ai.com, api.placement-ai.com) and APP_ENV=production are set in
# docker-compose.prod.yml itself and must not be overridden here.

# --- Database (Postgres inside the stack) -----------------------------------
DB_USER=pai_admin
# REQUIRED: a long random password, e.g. `openssl rand -base64 32`.
DB_PASSWORD=

# --- Sign-in: Firebase Auth (docs/AUTH_SESSION.md) ---------------------------
# REQUIRED. The service-account JSON goes to secrets/firebase-service-account.json.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json
# REQUIRED: the web app config from Firebase console (public values, compiled into the frontend).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Account emails (Resend) --------------------------------------------------
# REQUIRED. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Placement AI <noreply@placement-ai.com>
# Where student feedback is forwarded (optional).
FEEDBACK_EMAIL_TO=

# --- Founder / admin ----------------------------------------------------------
# Signed-in emails that may read GET /v1/admin/usage (comma separated).
PAI_FOUNDER_EMAILS=

# --- OpenAI (engines: extraction, planner, path analysis, Mirror text, research) ---
# REQUIRED.
PAI_API_KEY=
PAI_BASE_URL=https://api.openai.com/v1
PAI_MODEL=gpt-5-mini
PAI_PLANNER_MODEL=gpt-5-mini
PAI_ANALYST_MODEL=gpt-5
PAI_MIRROR_MODEL=gpt-5
PAI_RESEARCHER_MODEL=gpt-5
MEMORY_EXTRACTOR_MODEL=gpt-5-mini

# --- Anthropic (chat) ---------------------------------------------------------
# REQUIRED for Claude chat; without it the counselor role runs on OpenAI.
ANTHROPIC_API_KEY=
PAI_COUNSELOR_PROVIDER=anthropic
PAI_COUNSELOR_MODEL=claude-sonnet-5-5
PAI_COUNSELOR_REASONING_EFFORT=low

# --- Cost caps (USD per UTC month, estimated from model_costs.json) ------------
PAI_MONTHLY_CAP_USD=100
PAI_EMBEDDING_MONTHLY_CAP_USD=5

# --- Embeddings / semantic recall (Qdrant inside the stack) --------------------
# The OpenAI key again (text-embedding-3-small). Empty keeps recall lexical.
MEMORY_EMBEDDING_API_KEY=
PAI_SEMANTIC_RECALL_ENABLED=true

# --- Web research (field notes, rules refresh) --------------------------------
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=

# --- Ports and the reverse proxy ----------------------------------------------
# Host ports (127.0.0.1 only). Change FRONTEND_PORT when something else already
# listens on 3000 on this server (the website container does).
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Proxy on the host: leave unset and run `docker network create pai-beta_proxy` once.
# Proxy in Docker (website's Caddy container): its compose network name from `docker network ls`.
# PROXY_NETWORK=pai-website_default

# --- Server sizing -------------------------------------------------------------
# uvicorn workers in the API container. 2 for a 2-vCPU server, 4 for 4 vCPU.
WEB_CONCURRENCY=2
# Optional: `cloud` skips Chromium in the backend image (smaller build) when
# no browser-based research is wanted.
# BACKEND_IMAGE_TARGET=browser
